; ============================================================
; Mimiso LOE 2 - 模组 AI 适配演示
; 演示模组新增单位/科技在 AI(.per) 中的三种引用场景:
;   1) 研究模组升级科技: 长矛兵(3001: 早期长矛兵 -> 长矛兵)
;   2) 训练模组新增单位: 弩手(4002, 城堡时代由科技3006自动启用)
;   3) 研究模组升级科技: 劲弩手(3007: 弩手 -> 劲弩手)
; 使用: 遭遇战 AI 下拉框选择 MimisoDemo
; 注意: 本文件只演示适配写法, 不含经济/军事逻辑,
;       无靶场时 can-train 为假, 规则自动跳过, 不会报错
; ============================================================

; ------------------------------------------------------------
; 模组 ID 必须 defconst: 3000+/4000+ 不在引擎内置符号表
; (官方单位/科技如 spearman、archery-range 可直接用符号,
;  模组对象只有数字 ID, defconst 给它们起 .per 里的名字)
; ------------------------------------------------------------
(defconst u-early-spearman 4001)    ; 早期长矛兵 (黑暗, 科技87自动启用)
(defconst u-crossbowman 4002)       ; 弩手 (城堡, 科技3006自动启用)
(defconst u-arbalester 4003)        ; 劲弩手 (3007升级后由4002原位替换, 无需训练它)
(defconst t-spearman-upg 3001)      ; 长矛兵 升级科技 (封建@兵营)
(defconst t-crossbow-available 3006); 弩手可用科技 (城堡自动研究, AI无需操作)
(defconst t-arbalester-upg 3007)    ; 劲弩手 升级科技 (帝王@靶场)

; ------------------------------------------------------------
; 1) 点 早期长矛兵 -> 长矛兵 升级
;    can-research 自动处理前置(封建时代+科技87+资源), 到封建即可研究
; ------------------------------------------------------------
(defrule
    (can-research t-spearman-upg)
=>
    (research t-spearman-upg)
)

; ------------------------------------------------------------
; 2) 出弩手系
;    3006 在城堡时代自动研究完成 -> can-train 4002 变真
;    数量上限仅为演示防刷爆, 实装时改由战略目标控制
; ------------------------------------------------------------
(defrule
    (can-train u-crossbowman)
    (unit-type-count-total u-crossbowman < 15)
=>
    (train u-crossbowman)
)

; ------------------------------------------------------------
; 3) 升级精锐: 研究 劲弩手(3007)
;    研究后所有 4002 变为 4003, 靶场原训练按钮也变为 4003
;    -> AI 侧无需任何改动, 继续 train 4002 实际产出的就是劲弩手
; ------------------------------------------------------------
(defrule
    (can-research t-arbalester-upg)
=>
    (research t-arbalester-upg)
)

; ============================================================
; 附: 等价写法 - 兵种线(unitline)符号
; 模组 unitlines.json 已注册 loe-loe-crossbowman-line = [4002, 4003]
; 用线符号时引擎按当前已研究形态自动解析(未升级=4002, 升级后=4003),
; 这是官方 AI(Promisory) 的惯用写法, 线符号无需 defconst:
;
; (defrule
;     (can-train loe-loe-crossbowman-line)
;     (unit-type-count-total loe-loe-crossbowman-line < 15)
; =>
;     (train loe-loe-crossbowman-line)
; )
;
; 同理 spearman-line = [4001, 93, 358, 359],
; 官方 AI 若 train spearman-line, 黑暗时代产出的就是早期长矛兵,
; 研究3001/197/429后自动切换为长矛兵/长枪兵/长戟兵, 全程无需改AI。
; ============================================================
